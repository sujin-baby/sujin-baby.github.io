{
  "manifest_version": 3,
  "name": "상품 위치 찾기 (체험단)",
  "version": "1.7.0",
  "description": "쿠팡: 생성기가 연 상품 탭에서 상품 정보, 위치는 검색 화면에서 아이콘(지금 화면만 읽기). 확장은 쿠팡을 직접 열지 않음. 네이버: 검색 화면에서 상품을 찾아 표시(한 화면씩). 올리브영: 상품 정보와 검색 순위. 배송비 확인. 생성기 자동 가져오기. 썸네일 저장, 결과 복사",
  "action": {
    "default_title": "상품 위치 찾기",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "offscreen",
    "declarativeNetRequestWithHostAccess",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "*://*.coupang.com/*",
    "*://*.naver.com/*",
    "*://*.oliveyoung.co.kr/*",
    "*://*.coupangcdn.com/*",
    "*://*.pstatic.net/*",
    "https://raw.githubusercontent.com/*",
    "*://*.toss.shopping/*",
    "*://toss.shopping/*",
    "*://*.toss.im/*",
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "상품 위치 찾기"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "gen.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}